# =====================================================================
# Local dev (npm run dev) — talks to the standalone laselva-postgres
# container on the host. Skip these in production where docker compose
# wires DATABASE_URL automatically.
# =====================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/laselvaquiniela?schema=public"

# =====================================================================
# Shared by local dev and docker compose
# =====================================================================
# 32+ chars. Don't rotate without warning — it invalidates every session JWT.
AUTH_SECRET="replace-with-a-long-random-secret"
# Public URL the family will type. Local dev: http://localhost:3000
# Docker on the host: http://localhost   Production: https://laselvaquiniela.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="Selva2026!"
SEED_ADMIN_NAME="Admin La Selva"

# =====================================================================
# Docker compose only (docker compose up)
# =====================================================================
# Password for the `db` service. Same value is interpolated into the
# container's DATABASE_URL automatically — do NOT also set DATABASE_URL.
POSTGRES_PASSWORD="postgres"

# Caddy site address. Local smoke test: http://localhost
# Production VPS: bare domain like "laselvaquiniela.com" (auto HTTPS)
APP_DOMAIN="http://localhost"

# =====================================================================
# Auto-grader (ESPN public API — free, no key, covers World Cup 2026)
# =====================================================================
# No data-source key needed; the grader reads ESPN's public scoreboard and
# syncs FIFA world rankings from FIFA's public API (both free, no key).
# Secret to protect the /api/autograder endpoint (32+ chars)
AUTOGRADER_SECRET="replace-with-a-long-random-autograder-secret"
